# =============================================================================
# M17 Reflector (mrefd) container configuration
# =============================================================================
# Copy this file to `.env` and edit. `make init` will do this interactively.
# Every value below maps 1:1 to a line in mrefd.cfg or mrefd.mk, with the
# exceptions of the IMAGE_* and *_PORT variables (which control docker itself).
# =============================================================================


# -----------------------------------------------------------------------------
# Image / registry (docker-only, does not affect mrefd)
# -----------------------------------------------------------------------------
# Image tag used by both `make build` and `docker compose`.
IMAGE_MREFD=m17export/mrefd:latest
IMAGE_DASHBOARD=m17export/mrefd-dashboard:latest

# Platforms for `make build` (multi-arch buildx). Comma-separated.
# Common choices:
#   linux/arm64                       Raspberry Pi 4/5 (64-bit OS)
#   linux/arm/v7                      Raspberry Pi 3 / Zero 2W (32-bit OS)
#   linux/amd64                       x86_64 servers, Intel Macs
BUILD_PLATFORMS=linux/arm64,linux/arm/v7,linux/amd64


# -----------------------------------------------------------------------------
# Host networking / ports
# -----------------------------------------------------------------------------
# By default the mrefd service uses `network_mode: host` so it can accept BOTH
# IPv4 AND IPv6 traffic without any NAT rewriting - this is what you want on a
# Pi or server with real public addresses (v4 and/or v6). Under host mode, the
# ports below are *only* used to remind you what mrefd is listening on and to
# configure the firewall; they are not "published" by Docker.
#
# If you must run mrefd in bridge mode (e.g. Docker Desktop on macOS, or
# shared-tenant hosts), start with `docker compose -f docker-compose.yml
# -f docker-compose.bridge.yml up`; then M17_PORT/DHT_PORT become the actual
# host-side publish ports and IPv4 + IPv6 are both bound explicitly.
M17_PORT=17000            # UDP - M17 protocol (repeaters/hotspots connect here)
DHT_PORT=17171            # UDP - Ham-DHT peer discovery (leave 17171 unless you know why)

# The dashboard container always uses bridged networking with an explicit
# dual-stack port bind (IPv4 + IPv6), so this port is a real publish binding.
DASHBOARD_PORT=8080       # TCP - web dashboard (set to 80 for a bare domain)


# =============================================================================
# mrefd.cfg  (run-time configuration - rendered by the entrypoint)
# =============================================================================

# -----------------------------------------------------------------------------
# Identity - REQUIRED
# -----------------------------------------------------------------------------
# Reflector callsign: exactly 7 uppercase chars, must start with "M17-".
# Final 3 chars: A-Z or 0-9. Pick something NOT already at https://dvref.com.
MREFD_CALLSIGN=M17-XXX

# Modules to enable. Any subset of A-Z, no separators. Each module gets its
# own processing thread, so don't enable modules you won't use.
MREFD_MODULES=BCD

# Modules on which encrypted voice is allowed. Leave blank to forbid
# encryption everywhere. NOTE: many countries prohibit encrypted amateur
# transmissions - know your local regulations.
MREFD_ENCRYPTION_ALLOWED=

# Allow listen-only clients on encryption-enabled modules.
MREFD_LISTEN_ONLY_ALLOW_ENCRYPT=false


# -----------------------------------------------------------------------------
# Network binding (inside the container)
# -----------------------------------------------------------------------------
# UDP port mrefd listens on inside the container. Match M17_PORT above unless
# you're doing something unusual.
MREFD_PORT=17000

# Bind addresses. 0.0.0.0 = any IPv4, :: = any IPv6.
# Leave IPv4 empty for IPv6-only, or IPv6 empty for IPv4-only.
MREFD_IPV4_BIND=0.0.0.0
MREFD_IPV6_BIND=::

# External addresses. Leave EMPTY to let mrefd auto-detect via icanhazip.com.
# Only set these if you're behind an unusual NAT/proxy setup.
MREFD_IPV4_EXT=
MREFD_IPV6_EXT=


# -----------------------------------------------------------------------------
# Dashboard / registration - REQUIRED for DHT publication
# -----------------------------------------------------------------------------
# Public URL where the dashboard is reachable. Published to Ham-DHT so users
# can find your reflector's web page.
MREFD_DASHBOARD_URL=https://reflector.example.net

# Admin contact email. Also published to Ham-DHT.
MREFD_EMAIL=admin@example.net

# Two-letter ISO country code (https://www.iban.com/country-codes).
MREFD_COUNTRY=US

# Sponsor - optional free text. Cannot contain '='.
MREFD_SPONSOR=


# -----------------------------------------------------------------------------
# Ham-DHT (peer discovery)
# -----------------------------------------------------------------------------
# Set to false to disable DHT entirely (also drops DHT from the build).
# Recommended: true. Without DHT, users must hand-configure IPs and ports.
MREFD_DHT_ENABLED=true

# DHT bootstrap node. xrf757.openquad.net is a safe default. If you know a
# closer, well-connected M17 reflector, use it instead.
MREFD_BOOTSTRAP=xrf757.openquad.net


# =============================================================================
# mrefd.mk  (compile-time configuration - baked into the image)
# =============================================================================
# Changing any of these requires `make build` (or `make build-local`).

# Debug build (adds -ggdb3 -DDEBUG). Leave false for production.
MREFD_BUILD_DEBUG=false

# DHT support in the binary. Must match MREFD_DHT_ENABLED above.
MREFD_BUILD_DHT=true


# =============================================================================
# Dashboard (only used when the dashboard profile is enabled)
# =============================================================================

# IPs shown on the dashboard's landing page. Leave blank to auto-detect at
# container start (uses icanhazip.com, same as mrefd's DHT probe). Set
# DASHBOARD_IPV6=NONE only if you truly have no IPv6 connectivity - modern
# residential and datacenter networks increasingly provide native v6, and
# publishing it lets clients avoid CGNAT hops.
DASHBOARD_IPV4=
DASHBOARD_IPV6=

# Timezone for timestamp display. Any tz database name.
DASHBOARD_TZ=UTC

# Friendly names shown next to each module letter on the dashboard.
# Add DASHBOARD_MODULE_<X>=... lines for every module you enabled above.
DASHBOARD_MODULE_A=International
DASHBOARD_MODULE_B=Regional
DASHBOARD_MODULE_C=National
DASHBOARD_MODULE_D=Local

# IP privacy on the Links/Peers pages.
# One of: HideIP, ShowFullIP, ShowLast1ByteOfIP, ShowLast2ByteOfIP, ShowLast3ByteOfIP
DASHBOARD_IP_MODE=ShowLast2ByteOfIP
