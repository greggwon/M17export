# =============================================================================
# M17 Reflector configuration
#
# Copy this file to `mrefd.env` and edit. The five variables in the REQUIRED
# section are the minimum for a working reflector; everything else has a
# sensible default.
# =============================================================================


# ============================== REQUIRED =====================================

# Your reflector's callsign. Must be exactly "M17-" followed by three A-Z or
# 0-9 characters. Check https://dvref.com so you don't collide.
MREFD_CALLSIGN=M17-XYZ

# Modules to enable. Any subset of A-Z, no separators. One processing
# thread per module; don't enable modules you won't use.
MREFD_MODULES=BCD

# Two-letter ISO 3166 country code where this reflector is hosted.
MREFD_COUNTRY=US

# Your email (goes on the reflector's public dvref.com listing).
MREFD_EMAIL=you@example.net

# Public URL of your reflector's dashboard (goes on Ham-DHT).
MREFD_DASHBOARD_URL=https://reflector.example.net


# ============================== RECOMMENDED ==================================

# Sponsoring club / organization. Cannot contain '='. Blank is fine.
MREFD_SPONSOR=

# Which modules allow encrypted voice traffic. Blank = none. Know your local
# regulations - most amateur services prohibit over-the-air encryption.
MREFD_ENCRYPTION_ALLOWED=

# Ham-DHT peer discovery. Recommended: true.
MREFD_DHT_ENABLED=true
MREFD_BOOTSTRAP=xrf757.openquad.net


# ============================== NETWORKING (optional) ========================
# Only set these if the reflector's automatic external-address probing
# (icanhazip.com) gives the wrong answer for your NAT/proxy setup.
MREFD_IPV4_EXT=
MREFD_IPV6_EXT=

# Ports mrefd binds inside the container. If you change these, also change
# the port publishes in docker-compose.yml.
MREFD_PORT=17000

# Bind addresses inside the container. 0.0.0.0 = any IPv4, :: = any IPv6.
# Leave blank on one to run single-stack.
MREFD_IPV4_BIND=0.0.0.0
MREFD_IPV6_BIND=::


# ============================== BONJOUR ADVERTISEMENT ========================
# The container publishes _m17._udp on the LAN so MSeven and other Bonjour-
# aware clients auto-discover this reflector. Works out of the box on Linux
# with host networking. Set to "false" on Docker Desktop for macOS/Windows.
MREFD_ADVERTISE_ENABLED=true

# Optional MSeven-schema fields the advertiser embeds in the TXT record.
MREFD_ADVERTISE_NAME=
MREFD_ADVERTISE_DESCRIPTION=
MREFD_ADVERTISE_NETWORK_TYPE=


# ============================== TLS INTERLINK (optional) =====================
# Activates only if mrefd.interlink contains "key:" or "tls:" entries.
# Cert files go under config/tls/ (bind-mounted into /etc/mrefd/tls).
MREFD_TLS_SERVER_CERT=/etc/mrefd/tls/server.crt
MREFD_TLS_SERVER_KEY=/etc/mrefd/tls/server.key
MREFD_TLS_CLIENT_CERT=/etc/mrefd/tls/client.crt
MREFD_TLS_CLIENT_KEY=/etc/mrefd/tls/client.key
MREFD_TLS_TIMESTAMP_SKEW=300
